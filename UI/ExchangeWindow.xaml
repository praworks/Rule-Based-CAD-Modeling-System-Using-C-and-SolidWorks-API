<Window x:Class="AICAD.UI.ExchangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AICAD.UI.Models"
        Title="Exchange"
        Height="420" Width="900"
        WindowStartupLocation="CenterOwner"
        MinHeight="260" MinWidth="600">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="10" Background="{StaticResource PanelBackground}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
            <TextBlock Text="SYSTEM CHAT" FontWeight="Bold" FontSize="14" Margin="0,0,12,0" />
            <Button x:Name="BtnCopy" Content="Copy All" Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnClear" Content="Clear" Width="80" Height="28" Margin="0,0,6,0" />
            <CheckBox x:Name="ChkAutoscroll" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" />
            <TextBlock x:Name="LblStatus" Text="Live LLM conversation" Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Border Background="{StaticResource ConsoleBackground}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <StackPanel x:Name="DisabledPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="LLM trace disabled" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="Set AICAD_DEV_LLM_TRACE=1 to enable developer LLM tracing." Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <ScrollViewer x:Name="ChatScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="4">
                    <ItemsControl x:Name="ChatList"
                                  ItemsSource="{Binding Messages}"
                                  Background="{StaticResource ConsoleBackground}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatMessage}">
                                <StackPanel Margin="0,10">
                                    <TextBlock Text="{Binding Meta}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,4"
                                                   Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Body}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   xml:space="preserve">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
