<UserControl x:Class="AICAD.UI.TextToCADTaskpaneWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AICAD.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="472" d:DesignHeight="1200"
             Focusable="True"
             Width="Auto" Height="Auto"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ui:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <ui:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <Border Background="Transparent" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0" Margin="0,0,0,6" Padding="4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Select Series" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="seriesComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" Height="26" VerticalContentAlignment="Center" Background="{x:Null}">
                        <ComboBoxItem>ASM</ComboBoxItem>
                        <ComboBoxItem>PRT</ComboBoxItem>
                        <ComboBoxItem>DRW</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Background="Transparent" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0" Margin="0,0,0,6" Padding="4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Material" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="materialComboBox" SelectedIndex="-1" IsEditable="True" IsTextSearchEnabled="True" Height="26" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="{x:Null}" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" x:Name="applyMaterialButton" Content="✓" Width="26" Height="26" Padding="0" FontWeight="Bold" ToolTip="Apply selected material to active part" Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </Border>

            <Border Background="Transparent" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0" Margin="0,0,0,6" Padding="4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Description" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="typeDescriptionTextBox" Height="26" VerticalContentAlignment="Center" IsReadOnly="False" IsEnabled="True" Style="{StaticResource TextBoxStyle}" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>

            <Border Background="Transparent" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0" Margin="0,0,0,6" Padding="4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Weight" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="weightTextBox" Height="26" VerticalContentAlignment="Center" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>

            <Border Background="Transparent" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0" Margin="0,0,0,8" Padding="4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Generated Name Preview" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0"/>
                    <TextBox Grid.Column="1" x:Name="previewTextBox" Text="ASM-0018" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" Height="26" Style="{StaticResource TextBoxStyle}" Width="100"/>
                </Grid>
            </Border>

            <StackPanel Margin="0,4,0,0">
                <Button x:Name="saveWithNameButton" 
                    Content="Save With This Name" 
                    Height="26" Margin="0,0,0,4" 
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" CornerRadius="{StaticResource CardCornerRadius}" Padding="8,4" Margin="0,0,0,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProgressStatusPanel">
                        <!-- CoT Thinking status displayed during LLM reasoning -->
                        <Border x:Name="ThinkingContainer" Background="{StaticResource InputBorderBrush}" CornerRadius="4" Padding="8" Margin="0" Visibility="Collapsed">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="AI Activity" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource AccentBrush}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Goal" FontWeight="SemiBold" Margin="0,0,8,4" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActivityGoalText" Text="" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Now" FontWeight="SemiBold" Margin="0,0,8,4" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ActivityStatusText" Text="" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Source" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ActivityEvidenceText" Text="" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                                <TextBlock Text="Recent Events" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="ActivityTimelineText" Text="" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="16" Margin="0,0,0,10"/>
                                <TextBlock Text="Planner Notes" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="ThinkingText" Text="" TextWrapping="Wrap" FontStyle="Italic" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="16" MinHeight="88"/>
                                <StackPanel x:Name="QuestionsContainer" Orientation="Vertical" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="AI Questions" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="Firebrick"/>
                                    <TextBlock x:Name="QuestionsText" Text="" TextWrapping="Wrap" Foreground="Red" LineHeight="16"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="FeedbackMessageContainer" Background="{StaticResource InputBorderBrush}" CornerRadius="4" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="FeedbackMessageText" Text="" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <!-- User-friendly feedback text above prompt -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                           x:Name="promptFeedbackText" 
                           Text="💡 Describe what you want to create (e.g., 'box 50x50x100mm' or 'cylinder radius 20mm height 80mm')" 
                           Foreground="{StaticResource TextMutedBrush}" 
                           FontSize="11" 
                           Margin="2,0,0,4" 
                           TextWrapping="Wrap"
                           Opacity="0.85"/>

                <TextBox x:Name="prompt" Grid.Row="1" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6" GotFocus="prompt_GotFocus" LostFocus="prompt_LostFocus" PreviewKeyDown="prompt_PreviewKeyDown" Style="{StaticResource TextBoxStyle}" Margin="0,0,4,0"/>

                <Button x:Name="build" Grid.Row="1" Grid.Column="1" Content="Build 🚀" Height="26" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Prompt/Test" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,0,8,0"/>
            <ComboBox x:Name="shapePreset" Grid.Column="1" SelectedIndex="0" Height="26" VerticalContentAlignment="Center" Margin="4,0,4,0" ToolTip="Select a built-in prompt preset or one of the NL text-to-CAD test cases" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btnThumbUp" Content="👍" Background="Transparent" BorderThickness="0" Margin="0,0,3,0"/>
                <Button x:Name="btnThumbDown" Content="👎" Background="Transparent" BorderThickness="0"/>
                <Label x:Name="feedbackLabel" Content="Successful?" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="{StaticResource FontSizeTask}"/>
            </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnHistory" Content="History" Padding="6,1" Margin="3,0,0,0" FontSize="{StaticResource FontSizeTask}"/>
                <Button x:Name="btnExchange" Content="Exchange" Padding="6,1" Margin="3,0,0,0" FontSize="{StaticResource FontSizeTask}" ToolTip="Open Exchange window"/>
                <Button x:Name="btnStatus" Content="👁️" Padding="6,1" Margin="3,0,0,0"/>
                <Button x:Name="btnSettings" Content="⚙️" ToolTip="Settings" Padding="4,1" Margin="3,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>


